FROM serversideup/php@sha256:7203acfebeaa4bbbd64af26f8914158243606dfaeaf2617ea99fdb1fe6f69c83

USER root
WORKDIR /work/backend

# Deliberately enumerate the Laravel backend closure. The build context may contain
# other project files, but no environment, auth, Git, frontend, or private file is copied.
COPY backend/app app
COPY backend/bootstrap bootstrap
COPY backend/config config
COPY backend/database database
COPY backend/public public
COPY backend/resources resources
COPY backend/routes routes
COPY backend/storage storage
COPY backend/tests tests
COPY backend/vendor vendor
COPY backend/artisan backend/composer.json backend/composer.lock backend/phpunit.xml ./
COPY backend/docker/test-fixture-runner /usr/local/bin/kampy-test-fixture
COPY backend/docker/test-fixture-oracle.php /usr/local/lib/kampy-test-fixture-oracle.php

RUN chmod 0755 /usr/local/bin/kampy-test-fixture \
    && chmod 0644 /usr/local/lib/kampy-test-fixture-oracle.php \
    && mkdir -p bootstrap/cache storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && chmod -R u+rwX,g+rwX bootstrap/cache storage

WORKDIR /work/backend
ENTRYPOINT ["/usr/local/bin/kampy-test-fixture"]
